def _score_matching_repro_cards(repro_dir: Path, identifiers: set) -> list:
    matches = []
    if not repro_dir.is_dir():
        return matches
    for p in sorted(repro_dir.glob("*.json")):
        try:
            card = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        codes = set(card.get("toledo_codes") or [])
        if (codes & identifiers) or (card.get("claim") in identifiers):
            matches.append((p, card))
    return matches


def _score_matching_reviews(reviews_dir: Path, identifiers: set) -> list:
    matches = []
    if not reviews_dir.is_dir():
        return matches
    for p in sorted(reviews_dir.rglob("review_report.*")):
        if p.suffix not in (".yaml", ".yml", ".json"):
            continue
        try:
            report = load_instance(p)
        except Exception:
            continue
        if report.get("claim_ref") in identifiers:
            matches.append((p, report))
    return matches


def _rung(held, evidence=None, reason=None):
    row = {"held": bool(held), "evidence": evidence or []}
    if not held and reason:
        row["reason"] = reason
    return row


def cmd_score(args):
    """P23 (`glosa score`): print the R0-R6 Resistance Ladder table for one artifact -- a SET of
    rungs held, each with an evidence pointer, never a single number (design principle, restated
    at P23 §0). There is no --score/scalar flag; this command is built to refuse collapsing the
    table."""
    artifact = args.artifact
    kind = args.kind
    instance = None
    p = Path(artifact)
    if kind is None:
        if p.is_file():
            instance = load_instance(p)
            stem, _method = infer_stem(p, instance) if k else (None, None)
            kind = stem if stem in ("claim_card", "release_manifest") else "toledo-code"
        else:
            kind = "toledo-code"
    elif p.is_file() and kind in ("claim_card", "release_manifest"):
        instance = load_instance(p)

    identifiers = {artifact}
    toledo_code = artifact if kind == "toledo-code" else None
    if kind == "claim_card" and instance is not None:
        identifiers = {instance.get("claim_id") or artifact}
    elif kind == "release_manifest" and instance is not None:
        identifiers = {instance.get("manifest_id") or artifact}
        for ref in (instance.get("artifact_refs") or []):
            if isinstance(ref, dict) and ref.get("claim_id"):
                identifiers.add(ref["claim_id"])

    repro_dir = Path(args.repro_dir) if args.repro_dir else REPO_ROOT / "cases" / "repro"
    reviews_dir = Path(args.reviews_dir) if args.reviews_dir else REPO_ROOT / "reviews" / "routes"
    matching_cards = _score_matching_repro_cards(repro_dir, identifiers)
    # review_report.claim_ref names a CLAIM (text), never a bare Toledo code -- widen the set a
    # review is matched against to include every already-linked card's own `claim` text too (the
    # link a matching Reproduction Card itself establishes between this artifact and that claim),
    # so a review of the same claim a matching card backs still counts toward R5.
    review_identifiers = set(identifiers)
    for _cp, _card in matching_cards:
        if _card.get("claim"):
            review_identifiers.add(_card["claim"])
    matching_reviews = _score_matching_reviews(reviews_dir, review_identifiers)

    rungs = {}

    # R0 -- stated. Trivially held: this command was invoked with a real artifact identifier.
    rungs["R0"] = _rung(True, evidence=[{"type": "artifact", "ref": artifact, "kind": kind}])

    # R1 -- pre-registered falsifier / claim boundary.
    r1_evidence = []
    if k is not None:
        for cp, card in matching_cards:
            declared_at = k._parse_repro_timestamp((card.get("preregistered_prediction") or {}).get("declared_at"))
            run = card.get("run")
            if declared_at is None:
                continue
            if run is None:
                r1_evidence.append({"type": "reproduction_card", "path": _rel(cp)})
            else:
                run_date = k._parse_repro_timestamp(run.get("date"))
                if run_date is not None and declared_at <= run_date:
                    r1_evidence.append({"type": "reproduction_card", "path": _rel(cp)})
    if not r1_evidence and instance is not None and kind == "claim_card":
        falsifier = ((instance.get("five_questions") or {}).get("tested") or {}).get("falsifier", "")
        if falsifier and not falsifier.strip().upper().startswith("TODO"):
            r1_evidence.append({"type": "claim_card", "path": str(p), "field": "five_questions.tested.falsifier"})
    rungs["R1"] = _rung(bool(r1_evidence), evidence=r1_evidence,
                         reason="no linked reproduction_card.preregistered_prediction or claim_card falsifier")

    # R2 -- Coq-closed (kernel outside our loop). Read-only lookup against a Toledo registry file;
    # never guessed when the registry is not reachable.
    if toledo_code:
        registry_path = Path(args.toledo_registry) if args.toledo_registry else (REPO_ROOT.parent / "toledo" / "registry" / "CANONICAL.json")
        if not registry_path.is_file():
            rungs["R2"] = _rung(False, reason=f"toledo registry not found at {registry_path} -- pass --toledo-registry")
        else:
            try:
                data = json.loads(registry_path.read_text(encoding="utf-8"))
            except (OSError, ValueError) as exc:
                rungs["R2"] = _rung(False, reason=f"toledo registry at {registry_path} could not be parsed: {exc}")
            else:
                # registry/SCHEMA.md's own documented top level is {"schema_version", ...,
                # "canonical": [entries...]} -- try that key FIRST (integration fix, 2026-09-08:
                # the previous `data.get("entries") or list(data.values())` fallback silently
                # iterated the top-level dict's OWN values -- version strings, the commit hash,
                # the raw_to_canonical map -- never the nested entry list, so R2 could never be
                # held true against a real CANONICAL.json no matter what code was asked for).
                if isinstance(data, list):
                    entries = data
                elif isinstance(data, dict):
                    entries = data.get("canonical")
                    if not isinstance(entries, list):
                        entries = data.get("entries")
                    if not isinstance(entries, list):
                        entries = [v for v in data.values() if isinstance(v, dict) and "code" in v]
                else:
                    entries = []
                entry = next((e for e in entries if isinstance(e, dict) and e.get("code") == toledo_code), None)
                if entry is None:
                    rungs["R2"] = _rung(False, reason=f"code {toledo_code!r} not found in {registry_path}")
                else:
                    coq = entry.get("coq") or {}
                    coq_status = coq.get("coq_status") if isinstance(coq, dict) else entry.get("coq_status")
                    if coq_status == "closed":
                        rungs["R2"] = _rung(True, evidence=[{"type": "toledo_registry", "path": str(registry_path), "code": toledo_code, "coq_status": coq_status}])
                    else:
                        rungs["R2"] = _rung(False, reason=f"coq_status is {coq_status!r}, not 'closed'")
    else:
        rungs["R2"] = _rung(False, reason="no Toledo code given or reachable from this artifact")

    # R3 -- reproducible run, hash-frozen, AI = 0.
    r3_cards = [(cp, card) for cp, card in matching_cards if card.get("run") is not None]
    rungs["R3"] = _rung(bool(r3_cards), evidence=[{"type": "reproduction_card", "path": _rel(cp)} for cp, _ in r3_cards],
                         reason="no reproduction card references this artifact with a filled run{}")

    # R4 -- external oracle, PASS or FAIL both hold this rung (P0/P23 §0's own design principle).
    external_kinds = k._REPRO_EXTERNAL_ORACLE_KINDS if k is not None else (
        "published_value", "independent_implementation", "public_dataset")
    r4_cards = [
        (cp, card) for cp, card in r3_cards
        if (card.get("oracle") or {}).get("kind") in external_kinds
        and (card.get("result") or {}).get("status") in ("PASS", "FAIL")
    ]
    if not r3_cards:
        rungs["R4"] = _rung(False, reason="R3 not held")
    else:
        rungs["R4"] = _rung(
            bool(r4_cards),
            evidence=[{"type": "reproduction_card", "path": _rel(cp), "result_status": card["result"]["status"]} for cp, card in r4_cards],
            reason="no R3-holding card has a filled external-oracle result (PASS or FAIL)",
        )

    # R5 -- independent reviewer or interactional-expert record, independence_class >= I2.
    i5_evidence = []
    for rp, report in matching_reviews:
        ind = report.get("independence_class")
        if k is not None and ind in ("I2", "I3", "I4", "I5"):
            i5_evidence.append({"type": "review_report", "path": _rel(rp), "independence_class": ind})
    rungs["R5"] = _rung(bool(i5_evidence), evidence=i5_evidence,
                         reason="no review_report at independence_class >= I2 references this artifact")

    # R6 -- AOWC world record: an R4-holding card additionally passing the AOWC gate.
    if not rungs["R4"]["held"] or k is None:
        rungs["R6"] = _rung(False, reason="R4 not held")
    else:
        r6_evidence, r6_reasons = [], []
        for cp, card in r4_cards:
            aowc_held, aowc_reason = k.aowc_gate_check(card)
            if aowc_held:
                r6_evidence.append({"type": "reproduction_card", "path": _rel(cp), "aowc_reason": aowc_reason})
            else:
                r6_reasons.append(f"{_rel(cp)}: {aowc_reason}")
        rungs["R6"] = _rung(bool(r6_evidence), evidence=r6_evidence,
                             reason="; ".join(r6_reasons) if r6_reasons else "no R4-holding card passes the AOWC gate")

    return 0, {"action": "score", "artifact": artifact, "kind": kind, "rungs": rungs}


