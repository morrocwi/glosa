    a = schema.add_parser("summary", help="list every schema's title + required fields")
    a.set_defaults(func=cmd_schema_summary)

    a = sub.add_parser("self-test", help="run kernel.self_test()")
    a.set_defaults(func=cmd_self_test)

    a = sub.add_parser("demo", help="run the cat worked example end-to-end and print every verdict")
    a.set_defaults(func=cmd_demo)

    a = sub.add_parser("doctor", help="install health check: PASS/FAIL per item (python, deps, files, plugin manifest, kernel)")
    a.set_defaults(func=cmd_doctor)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    command_parts = [args.cmd] + ([args.sub] if hasattr(args, "sub") else [])
    command = " ".join(command_parts)
    args_dict = {kk: vv for kk, vv in vars(args).items() if kk not in ("func", "cmd", "sub")}
    try:
        exit_code, result = args.func(args)
        status = "ok" if exit_code == 0 else "non_zero_exit"
    except Exception as exc:  # noqa: BLE001 - report, never a bare traceback to the operator
        exit_code = 1
        result = {"action": command, "ok": False, "error": f"{type(exc).__name__}: {exc}"}
        status = "exception"
    _log(command, args_dict, status, extra={"exit_code": exit_code})
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=False))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
