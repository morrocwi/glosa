def cmd_repro_new(args):
    """P22 (`glosa repro new`): scaffold a fresh Reproduction Card. Fail-closed (exit 1, no file
    written) if `--statement` or `--tolerance` is empty -- the pre-registration must exist before
    any run (methodology/P22_reproduction_ledger.md item 1)."""
    statement, tolerance = (args.statement or "").strip(), (args.tolerance or "").strip()
    if not statement or not tolerance:
        return 1, {
            "action": "repro_new", "id": args.id,
            "error": "REFUSED (fail-closed): --statement and --tolerance must both be non-empty -- "
                     "the pre-registration must exist BEFORE any run (P22 item 1).",
        }
    toledo_codes = [c.strip() for c in (args.toledo_codes or "").split(",") if c.strip()]
    if not toledo_codes and not args.pending_toledo_code:
        return 1, {
            "action": "repro_new", "id": args.id,
            "error": "REFUSED (fail-closed): --toledo-codes is empty and --pending-toledo-code was "
                     "not passed -- toledo_codes[] may be empty ONLY when the card is honestly "
                     "status: pending_toledo_code; never invent a code to avoid this flag (P22).",
        }
    out_dir = Path(args.out_dir) if args.out_dir else REPO_ROOT / "cases" / "repro"
    data = scaffold_reproduction_card(
        args.id, toledo_codes, args.claim, args.oracle_kind, args.oracle_source,
        args.doi_or_url, args.version, statement, tolerance, args.human_owner,
        pending_toledo_code=args.pending_toledo_code,
    )
    # Reproduction cards are ALWAYS .json (design/RESISTANCE_LADDER_v0_1.md §2/§3: "Scaffolds
    # cases/repro/<ID>.json"), never the YAML-when-PyYAML-available convention every other
    # scaffold_* command follows -- `glosa score`/`_score_matching_repro_cards` and
    # `scripts/compute_resistance.py` (Toledo, S3) both glob cases/repro/*.json.
    out_dir.mkdir(parents=True, exist_ok=True)
    out_path = out_dir / f"{args.id}.json"
    out_path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    written = {"path": str(out_path), "format": "json"}
    res = run_check(data, "reproduction_card") if k else {"ok": None, "warnings": ["kernel not present -- scaffold not self-checked"]}
    return 0, {"action": "repro_new", "id": args.id, "written": written, "self_check": res}


def cmd_repro_run(args):
    """P22 item 2 (`glosa repro run`): execute the declared command, hash declared input/output
    files, and write `run{}`/`result{}` back to the card. Refuses (exit 1, no execution) if
    `preregistered_prediction.declared_at` is missing, if `run` is already filled (immutable --
    re-checking it is `repro verify`'s job), or if `--command` was not given. Exit 2 = the command
    itself could not be launched."""
    err = _need_repro_check()
    if err:
        return 1, {"action": "repro_run", "result": err}
    path = Path(args.path)
    instance = load_instance(path)
    if not (instance.get("preregistered_prediction") or {}).get("declared_at"):
        return 1, {"action": "repro_run", "path": str(path),
                    "error": "REFUSED: preregistered_prediction.declared_at is missing -- this card was "
                             "not properly pre-registered (P22 item 1)."}
    if instance.get("run") is not None:
        return 1, {"action": "repro_run", "path": str(path),
                    "error": "REFUSED: run{} is already filled -- a filled card is immutable. "
                             "Use `glosa repro verify` to independently re-check it, never an overwrite."}
    if not args.command:
        return 1, {"action": "repro_run", "path": str(path),
                    "error": "REFUSED: --command is required -- this driver never invents a command to run."}
    try:
        run_out = _repro_check.execute_run(args.command)
    except _repro_check.ReproCheckError as exc:
        return 2, {"action": "repro_run", "path": str(path), "ok": False, "error": str(exc)}
    declared_input_hash = _repro_check.sha256_of_files(args.input) if args.input else None
    declared_output_hash = _repro_check.sha256_of_files(args.output) if args.output else None
    hashes = _repro_check.compute_hashes(run_out["stdout"], declared_input_hash, declared_output_hash)
    tolerance = (instance.get("preregistered_prediction") or {}).get("tolerance", "")
    comparison = _repro_check.compare(run_out["observed"], args.reference, tolerance)
    instance["run"] = {
        "command": args.command, "input_hash": hashes["input_hash"], "output_hash": hashes["output_hash"],
        "ai_at_runtime": 0, "date": _now_iso(),
    }
    instance["result"] = {
        "status": comparison["status"], "observed": comparison["observed"], "deviation": comparison["deviation"],
    }
    # Always JSON, regardless of PyYAML availability -- reproduction cards are always .json (see
    # cmd_repro_new's own note); a plain dump_instance_text() would silently switch a .json file's
    # own content to YAML whenever PyYAML happens to be importable.
    path.write_text(json.dumps(instance, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    res = run_check(instance, "reproduction_card") if k else {"ok": None}
    return 0, {
        "action": "repro_run", "path": str(path), "status": comparison["status"], "note": comparison["note"],
        "returncode": run_out["returncode"], "stderr_tail": run_out["stderr"][-2000:],
        "self_check": res,
    }


def _repro_verify_one(path: Path, reviewer_identity, independence_class, input_paths, output_paths,
                       out_dir, isolated: bool):
    """One card's worth of `glosa repro verify` (P22 item 3): maker != checker (P10 NC-28/29). A
    DIFFERENT identity re-executes `run.command` fresh and confirms the recomputed hashes equal
    the ones already recorded, scaffolding a `review_report.yaml` (`role: SourceAuditor`) on the
    result rather than mutating the card. This is the file that actually HOLDS R3 for a reader
    other than the maker. `isolated=False` (the CLI's default) runs `run.command` in THIS repo's
    own checkout root, so a card whose command names a repo-relative path (the shape both
    first-batch real cards use, e.g. `python3 cases/repro/run_EQ-045_gauge_dim.py`) resolves the
    same way it did at `glosa repro run` time; `isolated=True` re-instates the original clean,
    empty, throwaway-temp-directory mode for a fully self-contained command (see
    `scripts/repro_check.py::verify_in_temp_dir`'s own docstring for the full rationale)."""
    instance = load_instance(path)
    run = instance.get("run")
    if run is None:
        return 1, {"action": "repro_verify", "path": str(path),
                    "error": "REFUSED: run{} is not filled yet -- run `glosa repro run` first."}
    reviewer = reviewer_identity or f"TODO: reviewer identity for {instance.get('id')} (must differ from lineage.run_by)"
    maker = (instance.get("lineage") or {}).get("run_by")
    if maker and reviewer == maker:
        return 1, {"action": "repro_verify", "path": str(path),
                    "error": f"REFUSED: --reviewer-identity ({reviewer!r}) equals lineage.run_by ({maker!r}) -- "
                             "same-identity self-verification has no standing (maker != checker)."}
    exec_cwd = None if isolated else str(REPO_ROOT)
    try:
        reexec = _repro_check.verify_in_temp_dir(run["command"], input_paths=input_paths, output_paths=output_paths,
                                                  cwd=exec_cwd)
    except _repro_check.ReproCheckError as exc:
        return 2, {"action": "repro_verify", "path": str(path), "ok": False, "error": str(exc)}
    input_match = reexec["input_hash"] == run.get("input_hash")
    output_match = reexec["output_hash"] == run.get("output_hash")
    hashes_match = input_match and output_match
    verdict = (
        f"hash match on re-execution: input_hash {'MATCH' if input_match else 'MISMATCH'} "
        f"({reexec['input_hash']!r} vs recorded {run.get('input_hash')!r}), "
        f"output_hash {'MATCH' if output_match else 'MISMATCH'} "
        f"({reexec['output_hash']!r} vs recorded {run.get('output_hash')!r})."
    )
    review_data = scaffold_review_report(instance.get("claim"), f"repro-verify-{instance.get('id')}", reviewer)
    review_data["role"] = "SourceAuditor"
    review_data["verdict"] = verdict
    review_data["verdict_tier"] = "finite_diagnostic" if hashes_match else "Dr"
    review_data["independence_class"] = independence_class or "I2"
    review_data["shared_dependency_disclosure"] = (
        "re-executed run.command fresh in a clean temporary directory (scripts/repro_check.py); "
        if isolated else
        f"re-executed run.command fresh in this repo's own checkout root ({REPO_ROOT}, scripts/repro_check.py); "
    ) + f"card at {_rel(path)}."
    resolved_out_dir = Path(out_dir) if out_dir else REPO_ROOT / "reviews" / "routes" / _slugify(instance.get("claim") or instance.get("id")) / f"repro-verify-{instance.get('id')}"
    written = write_new(resolved_out_dir, "review_report", review_data)
    res = run_check(review_data, "review_report") if k else {"ok": None}
    return (0 if hashes_match else 1), {
        "action": "repro_verify", "path": str(path), "hashes_match": hashes_match, "verdict": verdict,
        "written": written, "self_check": res,
    }


def cmd_repro_verify(args):
    """P22 item 3 (`glosa repro verify`) over one or more cards (`nargs="+"`, so
    `glosa repro verify cases/repro/*.json` runs every card the shell's own glob expands to, one
    at a time, in the order given -- never silently only the first). Exit code: 0 iff every card's
    hashes matched; 1 if any card's hashes mismatched (a real, reportable finding, never masked by
    another card's PASS); 2 if any card could not even be re-executed. `--out-dir`/`--input`/
    `--output` (when given) apply identically to every path in this invocation -- pass one card
    per invocation instead when they must differ per card."""
    err = _need_repro_check()
    if err:
        return 1, {"action": "repro_verify", "result": err}
    results = []
    worst = 0
    for raw_path in args.paths:
        code, payload = _repro_verify_one(
            Path(raw_path), args.reviewer_identity, args.independence_class, args.input, args.output,
            args.out_dir, args.isolated,
        )
        results.append(payload)
        worst = max(worst, code)
    if len(results) == 1:
        return worst, results[0]
    return worst, {"action": "repro_verify", "paths": list(args.paths), "results": results,
                    "all_hashes_match": all(r.get("hashes_match") for r in results if "hashes_match" in r)}


