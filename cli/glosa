    }


def cmd_lit_select(args):
    slug = _slugify(args.problem_slug)
    lit_root = RECORDS_ROOT / "records" / "lit" / slug
    candidates = []
    discovered = {}
    if lit_root.is_dir():
        for hyp_dir in sorted(p for p in lit_root.iterdir() if p.is_dir()):
            manifest_path = next(iter(sorted(hyp_dir.glob("litreview_manifest.*"))), None)
            if manifest_path is None:
                continue
            manifest = load_instance(manifest_path)
            hyp_ref = manifest.get("hypothesis_ref") or hyp_dir.name
            discovered[hyp_ref] = str(manifest_path)
            candidates.append({
                "hypothesis_ref": hyp_ref,
                "hypothesis_world": "",
                "lrs_manifest_ref": _rel(manifest_path),
                "dialogue_table_ref": _rel(hyp_dir / "dialogue_table.md"),
                "criteria": {},
                "accuracy_gate_at_selection_time": (manifest.get("gate") or {}).get("accuracy_gate", "PENDING"),
                "diversity_gate_at_selection_time": (manifest.get("gate") or {}).get("diversity_gate", "PENDING"),
            })
    if not candidates:
        return 1, {"action": "lit_select", "error": f"no frozen litreview_manifest found under {lit_root} -- "
                                                       "run `glosa lit new` + `glosa lit manifest` for at least one hypothesis first."}

    chosen = [] if not args.chosen else (list(discovered) if args.chosen.strip().lower() == "all" else [h.strip() for h in args.chosen.split(",") if h.strip()])
    unknown = [h for h in chosen if h not in discovered]
    if unknown:
        return 1, {"action": "lit_select", "error": f"--chosen names hypothesis_ref(s) not found among this problem's LRS runs: {unknown}",
                    "known": sorted(discovered)}

    park_args = {}
    for entry in (args.park or []):
        if ":" not in entry:
            return 1, {"action": "lit_select", "error": f"--park entry {entry!r} must be '<hypothesis_ref>:<reason>'"}
        href, reason = entry.split(":", 1)
        park_args[href.strip()] = reason.strip()
    parked = []
    for href in discovered:
        if href in chosen:
            continue
        reason = park_args.get(href)
        if not reason:
            return 1, {"action": "lit_select",
                        "error": f"hypothesis_ref {href!r} is neither chosen nor parked-with-a-reason -- "
                                 f"pass --chosen including it, or --park '{href}:<reason>' (never silently dropped)."}
        parked.append({"hypothesis_ref": href, "reason": reason})

    hsel_id = _next_numbered_id(lit_root, lambda n: f"hsel-{slug}-{n:03d}")
    data = scaffold_hypothesis_selection(
        hsel_id, args.problem_ref or slug, args.decided_by, candidates, chosen, args.reason, parked,
        args.cooking_log_ref or "NOT_YET_LOGGED -- TODO: append this selection to the Blackbox Note cooking log and put its ref here.",
        session_id=getattr(args, "session_id", None),
    )
    written = write_new(lit_root, hsel_id, data)
    res = run_check(data, "hypothesis_selection") if k else {"ok": None}
    return 0, {"action": "lit_select", "hsel_id": hsel_id, "written": written, "self_check": res}


