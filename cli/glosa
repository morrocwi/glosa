def cmd_lit_freeze(args):
    slug = _slugify(args.problem_slug)
    hyp_dir = _slugify(args.hypothesis_ref)
    out_dir = REPO_ROOT / "records" / "lit" / slug / hyp_dir
    sl_path = next(iter(sorted(out_dir.glob("search_log.*"))), None)
    if sl_path is None:
        return 1, {"action": "lit_freeze", "error": f"no search_log found under {out_dir} -- run `glosa lit new` first."}
    search_log = load_instance(sl_path)
    frozen_scope = search_log.get("frozen_scope") or {}
    if not (frozen_scope.get("hypothesis_or_falsifier") or "").strip():
        return 1, {"action": "lit_freeze", "path": str(sl_path),
                    "error": "frozen_scope.hypothesis_or_falsifier is empty -- fill the scope before freezing."}
    if search_log.get("sources_found"):
        return 1, {"action": "lit_freeze", "path": str(sl_path),
                    "error": "sources_found is already non-empty -- this search was opened before being "
                              "frozen (S14 §2.2's 'frozen BEFORE sources_found is populated'); cannot freeze "
                              "in place. Start a fresh `glosa lit new` run if the scope needs to change."}
    freeze_log = out_dir / "FREEZE_LOG.jsonl"
    with open(freeze_log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"event": "freeze", "ts": _now_iso(), "search_log_id": search_log.get("id")}, ensure_ascii=False) + "\n")
