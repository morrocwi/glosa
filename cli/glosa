def _schema_filenames() -> list:
    return sorted(p.name for p in SCHEMA_DIR.glob("*.schema.json") if p.name != "common.defs.json")


_STEM_CACHE = None


def _kind_stems() -> dict:
    global _STEM_CACHE
    if _STEM_CACHE is None:
        _STEM_CACHE = {fn[: -len(".schema.json")]: fn for fn in _schema_filenames()}
    return _STEM_CACHE


_REQUIRED_CACHE: dict = {}


def _schema_required(schema_filename: str) -> set:
    if schema_filename not in _REQUIRED_CACHE:
        try:
            data = json.loads((SCHEMA_DIR / schema_filename).read_text(encoding="utf-8"))
            _REQUIRED_CACHE[schema_filename] = set(data.get("required") or [])
        except (OSError, ValueError):
            _REQUIRED_CACHE[schema_filename] = set()
    return _REQUIRED_CACHE[schema_filename]


def _schema_title(schema_filename: str) -> str:
    try:
        data = json.loads((SCHEMA_DIR / schema_filename).read_text(encoding="utf-8"))
        return data.get("title") or schema_filename
    except (OSError, ValueError):
        return schema_filename


# Kernel-backed validators (FOUNDATION §9's named list) -- everything else in the 19 remaining
# schemas is checked generically via kernel's own _schema_validate (schema+jsonschema, the same
# code path validate_claim_card/etc. use internally -- one fact, one home for HOW a schema is
# checked, never re-implemented here).
_KERNEL_VALIDATORS = {
    "claim_card": "validate_claim_card",
    "review_report": "validate_review_report",
    "citation_card": "validate_citation_card",
    "release_manifest": "validate_release_manifest",
    "blackbox_note": "validate_blackbox_note",
}
_LIT_GATE_STEM = "litreview_manifest"


def infer_stem(path: Path, instance):
    """Dispatch by $schema (content) or filename, per task instruction; falls back to a clearly
    labeled field-fingerprint guess only when neither of those two resolves anything, so a caller
    can tell "recognized" apart from "guessed"."""
    stems = _kind_stems()
    if isinstance(instance, dict):
        s = instance.get("$schema")
        if isinstance(s, str) and s.strip():
            cand = s.strip().split("/")[-1]
            if cand.endswith(".schema.json"):
                cand = cand[: -len(".schema.json")]
            elif cand.endswith(".json"):
                cand = cand[: -len(".json")]
            if cand in stems:
                return cand, "content:$schema"

    norm = re.sub(r"[^a-z0-9]+", "_", path.stem.lower()).strip("_")
    matches = sorted((s for s in stems if s in norm), key=len, reverse=True)
    if matches:
        return matches[0], "filename"

    if isinstance(instance, dict):
        keys = set(instance.keys())
        best_stem, best_ratio, best_all = None, 0.0, False
        for stem, fname in stems.items():
            req = _schema_required(fname)
            if not req:
                continue
            overlap = len(req & keys)
            ratio = overlap / len(req)
            if ratio > best_ratio:
                best_stem, best_ratio, best_all = stem, ratio, (overlap == len(req))
        if best_stem and best_ratio >= 0.5:
            note = "all required fields present" if best_all else f"{best_ratio:.0%} of required fields present"
            return best_stem, f"field-fingerprint ({note}) -- NOT $schema/filename, use with caution"

    return None, None


def generic_schema_check(instance, schema_filename) -> dict:
    errors, used_fallback = k._schema_validate(instance, schema_filename)
    warnings = ["jsonschema not available -- used the minimal required-field fallback check only."] if used_fallback else []
    return k._result(ok=not errors, errors=errors, warnings=warnings)


def run_check(instance, stem) -> dict:
    fname = _kind_stems()[stem]
    if stem in _KERNEL_VALIDATORS:
        return getattr(k, _KERNEL_VALIDATORS[stem])(instance)
    if stem == _LIT_GATE_STEM:
        return k.lit_gate(instance)
    return generic_schema_check(instance, fname)


