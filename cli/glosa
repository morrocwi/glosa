def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    command_parts = [args.cmd] + ([args.sub] if hasattr(args, "sub") else [])
    command = " ".join(command_parts)
    args_dict = {kk: vv for kk, vv in vars(args).items() if kk not in ("func", "cmd", "sub")}
    try:
        exit_code, result = args.func(args)
        status = "ok" if exit_code == 0 else "non_zero_exit"
    except Exception as exc:  # noqa: BLE001 - report, never a bare traceback to the operator
        exit_code = 1
        result = {"action": command, "ok": False, "error": f"{type(exc).__name__}: {exc}"}
        status = "exception"
    _log(command, args_dict, status, extra={"exit_code": exit_code})
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=False))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
