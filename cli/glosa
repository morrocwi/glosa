    a.add_argument("--human-owner", required=True)
    a.add_argument("--origin-blackbox-ref", default=None)
    a.add_argument("--out-dir", default=None)
    a.set_defaults(func=cmd_claim_new)
    a = claim.add_parser("validate", help="validate a claim_card file")
    a.add_argument("path")
    a.set_defaults(func=cmd_claim_validate)
