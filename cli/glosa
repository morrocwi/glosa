def cmd_session_close(args):
    """SA-1 (build_now). Fail-closed per task instruction: refuses (exit 1, no file written) unless
    `--retention-note` is a non-empty, human-authored string -- an AI session may never author this
    field's content on the human's behalf (§6 Boundary check; templates/knowledge/blackbox_note.yaml
    `retention_note`: 'human writes, AI never fills'). Reads/writes `session_id`/`session_boundary`/
    `retention_note` at the note's TOP LEVEL (MUST fix, ARCH_REVIEW_v0.7.json), matching
    schema/blackbox_note.schema.json and kernel/glosa_kernel.py's `check_session_boundary_reset` --
    never a nested `session:` wrapper."""
    path = Path(args.path)
    instance = load_instance(path)
    if "session_id" not in instance or not isinstance(instance.get("session_boundary"), dict):
        return 1, {"action": "session_close", "path": str(path),
                    "error": "this Blackbox Note has no top-level session_id/session_boundary -- it was not opened with `glosa session open`."}
    boundary = instance.get("session_boundary") or {}
    if boundary.get("closed_at"):
        return 1, {"action": "session_close", "path": str(path),
                    "error": f"session {instance.get('session_id')!r} is already closed (closed_at={boundary.get('closed_at')!r})."}
    note = (args.retention_note or "").strip()
    if not note:
        return 1, {
            "action": "session_close", "path": str(path),
            "error": "REFUSED (fail-closed): --retention-note is required and must be a non-empty, "
                     "human-authored string. This field is never AI-filled -- pass the human's own "
                     "words for what they explicitly retain from this session, or 'none' if they "
                     "explicitly retain nothing (never left silently blank).",
        }
    boundary["closed_at"] = _now_iso()
    boundary["ai_state_at_boundary"] = "reset"  # v7.1:331 -- fixed literal at close, always, by architectural scope
    instance["session_boundary"] = boundary
    instance["retention_note"] = note
    if args.retained_direction_ref:
        instance["retained_direction_ref"] = args.retained_direction_ref
    path.write_text(dump_instance_text(instance), encoding="utf-8")
    res = run_check(instance, "blackbox_note") if k else {"ok": None}
    return 0, {"action": "session_close", "path": str(path), "session_id": instance.get("session_id"),
               "closed_at": boundary["closed_at"], "self_check": res}


