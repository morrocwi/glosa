    # kg -----------------------------------------------------------------------------------------
    kg = sub.add_parser("kg", help="knowledge graph nodes/edges (FOUNDATION §8.1)").add_subparsers(dest="sub", required=True)
    a = kg.add_parser("validate", help="dangling refs + derives_from cycles")
