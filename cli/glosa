def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _today() -> str:
    return datetime.now(timezone.utc).date().isoformat()


def _slugify(text: str) -> str:
    """Lowercase, [a-z0-9-]+ only -- matches every slug-bearing id pattern in schema/*.schema.json
    (search-, litrev-, hsel-, cp-). Never invents content; a caller-supplied slug that collapses
    to empty after normalization is rejected by the caller, not silently replaced here."""
    s = re.sub(r"[^a-z0-9]+", "-", (text or "").strip().lower()).strip("-")
    return s or "x"


def ext() -> str:
    return ".yaml" if HAVE_YAML else ".json"


def load_instance(path) -> dict:
    """Load a YAML or JSON instance by extension; falls back to trying JSON then YAML if the
    extension is ambiguous or absent. Raises on genuine parse failure -- never swallows a bad
    file into a fabricated empty instance."""
    p = Path(path)
    text = p.read_text(encoding="utf-8")
    suffix = p.suffix.lower()
    if suffix in (".yaml", ".yml"):
        if not HAVE_YAML:
            raise RuntimeError(f"{p} looks like YAML but PyYAML is not installed in this environment")
        return yaml.safe_load(text)
    if suffix == ".json":
        return json.loads(text)
    # unknown/absent extension: try JSON first (stricter, fails fast), then YAML if available
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        if HAVE_YAML:
            return yaml.safe_load(text)
        raise


def dump_instance_text(data) -> str:
    if HAVE_YAML:
        return yaml.safe_dump(data, allow_unicode=True, sort_keys=False, default_flow_style=False, width=100)
    return json.dumps(data, ensure_ascii=False, indent=2, sort_keys=False) + "\n"


def write_new(out_dir: Path, stem: str, data: dict, extra_files: dict | None = None) -> dict:
    """Write one scaffolded instance to out_dir/<stem><ext()>, plus any extra_files
    ({relative_name: text_content}) alongside it (e.g. a companion dialogue_table.md). Returns
    {"path": str, "extra_paths": {...}, "format": "yaml"|"json", "pyyaml_available": bool}."""
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / f"{stem}{ext()}"
    path.write_text(dump_instance_text(data), encoding="utf-8")
    extra_paths = {}
    for name, content in (extra_files or {}).items():
        p = out_dir / name
        p.write_text(content, encoding="utf-8")
        extra_paths[name] = str(p)
    return {
        "path": str(path),
        "extra_paths": extra_paths,
        "format": "yaml" if HAVE_YAML else "json",
        "pyyaml_available": HAVE_YAML,
    }


def _next_numbered_id(dir_path: Path, build) -> str:
    """Smallest n>=1 such that build(n) is not already the stem of an existing .yaml/.json file
    in dir_path. Not concurrency-safe (fine for a single-operator CLI, not a shared service)."""
    dir_path.mkdir(parents=True, exist_ok=True)
    existing = {p.stem for p in dir_path.glob("*") if p.suffix in (".yaml", ".yml", ".json")}
    n = 1
    while True:
        candidate = build(n)
        if candidate not in existing:
            return candidate
        n += 1


def _log(command: str, args_dict: dict, status: str, extra: dict | None = None) -> None:
    """Append one {"kind": "tool_call", ...} line to ./logbook.jsonl in the CURRENT working
    directory (task instruction, matching mcp/glosa_mcp_server.py's own logbook contract).
    Best-effort: a logging failure is reported to stderr, never raised past this function."""
    record = {
        "kind": "tool_call",
        "ts": _now_iso(),
        "cli": "glosa",
        "command": command,
        "args": {k2: str(v) if isinstance(v, Path) else v for k2, v in (args_dict or {}).items()},
        "status": status,
    }
    if extra:
        record.update(extra)
    try:
        with open(Path.cwd() / "logbook.jsonl", "a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")
    except Exception as exc:  # noqa: BLE001 - logging must never crash a command
        print(f"[glosa] WARNING: logbook write failed: {exc}", file=sys.stderr)


