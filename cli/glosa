def scaffold_dialogue_table_text(hypothesis_ref) -> str:
    template_path = TEMPLATES_DIR / "dialogue_table.md"
    text = template_path.read_text(encoding="utf-8") if template_path.is_file() else (
        "## Hypothesis this table belongs to\n"
        "- hypothesis_id (claim_card.claim_id / r2_hypothesis_ref):\n"
        "- hypothesis_world (verbatim R2 text):\n"
        "- falsifier:\n\n"
        "## Table\n\n"
        "| source | how it sees the problem | what it separates | what it assumes | "
        "agrees with H | disagrees with H | what it would say against us | citation_card | verified |\n"
        "|---|---|---|---|---|---|---|---|---|\n"
    )
    text = text.replace(
        "- hypothesis_id (claim_card.claim_id / r2_hypothesis_ref):",
        f"- hypothesis_id (claim_card.claim_id / r2_hypothesis_ref): {hypothesis_ref}",
    )
    return text


def _render_dialogue_table_rows(rows) -> str:
    header = (
        "| source | how it sees the problem | what it separates | what it assumes | "
        "agrees with H | disagrees with H | what it would say against us | citation_card | verified |\n"
        "|---|---|---|---|---|---|---|---|---|\n"
    )
    stance_col = {"YES": "YES", "NO": "NO", "ORTHOGONAL": "ORTHOGONAL", "UNDETERMINED": "UNDETERMINED"}
    lines = [header]
    for row in rows:
        verified = row.get("verified") or {}
        lines.append(
            "| {src} | {sees} | {sep} | {assume} | {stance} | {stance} | {against} | {cite} | {ver} |\n".format(
                src=row.get("source_label", ""),
                sees=row.get("how_it_sees_the_problem", ""),
                sep=row.get("what_it_separates", ""),
                assume=row.get("what_it_assumes", ""),
                stance=stance_col.get(row.get("stance"), row.get("stance", "")),
                against=row.get("what_it_would_say_against_us", ""),
                cite=row.get("citation_card", ""),
                ver=f"metadata:{verified.get('metadata_verified')} / claim_match:{verified.get('claim_match_verified')}",
            )
        )
    return "".join(lines)


def _rel(path) -> str:
    """Repo-relative path string for refs written into public artifacts (never an absolute
    /home/... path -- leak-scan regression, 2026-09-04)."""
    try:
        return str(Path(path).resolve().relative_to(REPO_ROOT.resolve()))
    except ValueError:
        return str(path)


def scaffold_litreview_manifest(manifest_id, hypothesis_ref, search_log_ref, human_owner, citations) -> dict:
    total = len(citations)
    verified_count = sum(1 for c in citations if c.get("status") == "VERIFIED")
    all_verified = total > 0 and verified_count == total
    accuracy_gate = "PASS" if all_verified else "FAIL"
    diversity_audit = {
        "counts": {
            "by_language": {}, "by_source_type": {}, "by_search_route_or_database": {},
            "by_stance": {"agrees": 0, "disagrees": 0, "orthogonal": 0, "undetermined": 0},
            "by_geography_or_institution": {},
        },
        "concentration_flags": [],
        "zero_disagree_flag": False,
        "never_claim_diverse_without_counts": True,
    }
    for c in citations:
        div = c.get("diversity") or {}
        lang = div.get("language")
        if lang:
            diversity_audit["counts"]["by_language"][lang] = diversity_audit["counts"]["by_language"].get(lang, 0) + 1
        stance = c.get("dialogue_table_stance") or "undetermined"
        diversity_audit["counts"]["by_stance"][stance] = diversity_audit["counts"]["by_stance"].get(stance, 0) + 1
    diversity_gate = "PASS" if total > 0 else "FAIL"
    if accuracy_gate == "FAIL":
        overall, blocked_reason = "FAIL", (
            "No citation recorded for this hypothesis yet -- run `glosa lit new` then add "
            "citation rows before `glosa lit manifest` can compute a real gate (S14 §10 worked "
            "example: this is the honest FAIL state, not an error)."
        ) if total == 0 else "Not every listed citation reached VERIFIED yet."
    elif diversity_gate == "FAIL":
        overall, blocked_reason = "PASS_WITH_LIMITS", None
    else:
        overall, blocked_reason = "PASS", None
    return {
        "$schema": "litreview_manifest.schema.json",
        "id": manifest_id,
        "hypothesis_ref": hypothesis_ref,
        "search_log_ref": search_log_ref,
        "search_log_hash": "",
        "dialogue_table_ref": "",
        "neighbour_table_ref": "",
        "status": "DRAFTING",
        "frozen_at": None,
        "supersedes": None,
        "citations": citations,
        "strata_table": [],
        "diversity_audit": diversity_audit,
        "accuracy": {
            "total_citations": total,
            "verified_count": verified_count,
            "spot_check": {
                "applicable": total > 0,
                "proposed_n_percent": 20,
                "small_n_rule_applied": total < 10,
                "sampled_citation_ids": [],
                "sample_size": 0,
                "spot_check_result": "PENDING",
                "spot_checked_by": None,
                "spot_checked_at": None,
            },
        },
        "secondary_citation_ban_audit": {"violations_found": 0},
        "gate": {"accuracy_gate": accuracy_gate, "diversity_gate": diversity_gate, "overall": overall, "blocked_reason": blocked_reason},
        "disclaimers_emitted": [{"id": "D-CITATION-UNVERIFIED"}] if not all_verified else [],
        "human_owner": human_owner,
    }


