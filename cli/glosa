    # intake -----------------------------------------------------------------------------------
    intake = sub.add_parser("intake", help="S1 problem_card intake gate").add_subparsers(dest="sub", required=True)
    a = intake.add_parser("new", help="scaffold a new problem_card")
    a.add_argument("--project", required=True)
    a.add_argument("--human-owner", required=True)
    a.add_argument("--origin-blackbox-ref", default=None)
    a.add_argument("--out-dir", default=None)
