    for rel in ("kernel/glosa_kernel.py", "schema/claim_card.schema.json", "design/FOUNDATION_v0.5.md",
                "plugins/glosa/.claude-plugin/plugin.json", ".claude-plugin/marketplace.json",
                "plugins/glosa/PROMPT_PACKET.md", "mcp/glosa_mcp_server.py", "requirements.txt"):
        row("file: " + rel, (REPO_ROOT / rel).exists())
    try:
        mk = json.loads((REPO_ROOT / ".claude-plugin/marketplace.json").read_text(encoding="utf-8"))
        srcs = [pl.get("source") for pl in mk.get("plugins", [])]
        local_ok = all(isinstance(src, str) and src.startswith("./") and (REPO_ROOT / src).is_dir() for src in srcs)
        row("plugin manifest: in-repo source (no remote clone / no ssh)", local_ok, str(srcs))
    except Exception as e:  # noqa: BLE001
        row("plugin manifest parse", False, str(e))
    skills = REPO_ROOT / "plugins/glosa/skills"
    missing = [d.name for d in skills.iterdir() if d.is_dir() and not (d / "SKILL.md").exists()] if skills.exists() else ["(no skills dir)"]
    row("skills: every skill has SKILL.md", not missing, ", ".join(missing) or "%d skills" % len(list(skills.iterdir())))
    err = _need_kernel()
    if err:
        row("kernel import", False, str(err))
    else:
        res = k.self_test()
        row("kernel self_test", res.get("ok"), res.get("verdict"))
    link = Path.home() / ".local/bin/glosa"
    ok_all = all(r[1] for r in rows)
    for name, ok, detail in rows:
        print("%s  %-58s %s" % ("PASS" if ok else "FAIL", name, detail))
    print("INFO  %-58s %s" % ("cli link ~/.local/bin/glosa", str(link.resolve()) if link.exists() else "not linked (install.sh creates it; optional)"))
    print("glosa doctor:", "PASS — ใช้งานได้" if ok_all else "FAIL — see FAIL lines above (ดูบรรทัด FAIL)")
    return (0 if ok_all else 1), {"action": "doctor", "ok": ok_all, "checks": [{"name": n, "ok": o, "detail": d} for n, o, d in rows]}


def cmd_demo(args):
    err = _need_kernel()
    if err:
        return 1, {"action": "demo", "result": err}
    ex = SCHEMA_DIR / "examples"

    def _load(name):
        return json.loads((ex / name).read_text(encoding="utf-8"))

    problem = _load("problem_card.example.json")
    blackbox = _load("blackbox_note.example.json")
    claim = _load("claim_card.example.json")
    citation = _load("citation_card.example.json")
    review = _load("review_report.example.json")
    manifest = _load("release_manifest.example.json")

    steps = {}
    steps["intake_check"] = generic_schema_check(problem, "problem_card.schema.json")
    steps["blackbox_note_check"] = k.validate_blackbox_note(blackbox)
    steps["claim_card_check"] = k.validate_claim_card(claim)
    steps["citation_card_check"] = k.validate_citation_card(citation)
    steps["review_report_check"] = k.validate_review_report(review)
    steps["release_manifest_check"] = k.validate_release_manifest(manifest)
    steps["disclaimers"] = k.compute_disclaimers(claim)
    steps["genre_route"] = k.route_genre(claim)
    steps["independence_ceiling"] = k.independence_ceiling((claim.get("five_questions") or {}).get("tested", {}).get("evidence_relations") or [])
    steps["silent_lift_check"] = k.silent_lift_check(claim)
    dag = claim.get("provenance_dag") or {}
    first_node = ((dag.get("nodes") or [{}])[0]).get("id")
    steps["defeater_route"] = k.defeater_route(dag, first_node)
    steps["gate_release"] = k.gate_release(manifest, [claim], [review])
    steps["self_test"] = k.self_test()

    all_ok = all(
        v.get("ok") is not False
        for v in steps.values()
        if isinstance(v, dict) and "ok" in v
    )
    return (0 if all_ok else 1), {"action": "demo", "case": "worked-example-cat (schema/examples/*)",
                                   "steps": steps, "all_ok": all_ok}


