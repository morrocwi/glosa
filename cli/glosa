def cmd_kg_validate(args):
    err = _need_kernel()
    if err:
        return 1, {"action": "kg_validate", "result": err}
    kg_dir = Path(args.dir)
    nodes_path, edges_path = kg_dir / "nodes.jsonl", kg_dir / "edges.jsonl"
    node_errors, edge_errors, dangling = [], [], []
    node_ids = set()
    if nodes_path.is_file():
        for i, line in enumerate(nodes_path.read_text(encoding="utf-8").splitlines()):
            if not line.strip():
                continue
            node = json.loads(line)
            res = generic_schema_check(node, "kg_node.schema.json")
            if not res["ok"]:
                node_errors.append({"line": i + 1, "id": node.get("id"), "errors": res["errors"]})
            else:
                node_ids.add(node.get("id"))
    derives_edges = []
    if edges_path.is_file():
        for i, line in enumerate(edges_path.read_text(encoding="utf-8").splitlines()):
            if not line.strip():
                continue
            edge = json.loads(line)
            res = generic_schema_check(edge, "kg_edge.schema.json")
            if not res["ok"]:
                edge_errors.append({"line": i + 1, "id": edge.get("id"), "errors": res["errors"]})
                continue
            frm, to = edge.get("from"), edge.get("to")
            if node_ids and (frm not in node_ids or to not in node_ids):
                dangling.append({"line": i + 1, "id": edge.get("id"), "from": frm, "to": to})
            if edge.get("relation") == "derives_from":
                derives_edges.append((frm, to))

    # cycle detection over derives_from edges only
    adjacency = {}
    for frm, to in derives_edges:
        adjacency.setdefault(frm, []).append(to)
    cyclic = False
    cycle_path = []

    def _dfs(node, path, visited):
        nonlocal cyclic, cycle_path
        if cyclic:
            return
        if node in visited:
            cyclic = True
            cycle_path = path + [node]
            return
        for nxt in adjacency.get(node, []):
            _dfs(nxt, path + [node], visited | {node})

    for start in list(adjacency):
        _dfs(start, [], set())
        if cyclic:
            break

    ok = not (node_errors or edge_errors or dangling or cyclic)
    return (0 if ok else 1), {
        "action": "kg_validate", "dir": str(kg_dir),
        "nodes_checked": len(node_ids) + len(node_errors), "node_errors": node_errors,
        "edges_checked": len(derives_edges) + len(edge_errors), "edge_errors": edge_errors,
        "dangling_refs": dangling, "derives_from_cycle": cyclic, "cycle_path": cycle_path, "ok": ok,
    }


def cmd_kg_merge(args):
    out_dir = Path(args.out_dir)
    project_dirs = [Path(p) for p in _glob.glob(args.projects_glob)]
    if not project_dirs:
        return 0, {"action": "kg_merge", "projects_glob": args.projects_glob, "projects_found": 0,
                    "note": "no per-project kg/ directories matched -- nothing to merge, output left untouched."}
    merged_nodes, merged_edges = {}, {}
    dup_nodes, dup_edges = [], []
    for pd in project_dirs:
        np_, ep_ = pd / "nodes.jsonl", pd / "edges.jsonl"
        if np_.is_file():
            for line in np_.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                obj = json.loads(line)
                if obj.get("id") in merged_nodes:
                    dup_nodes.append(obj.get("id"))
                merged_nodes[obj.get("id")] = obj
        if ep_.is_file():
            for line in ep_.read_text(encoding="utf-8").splitlines():
                if not line.strip():
                    continue
                obj = json.loads(line)
                if obj.get("id") in merged_edges:
                    dup_edges.append(obj.get("id"))
                merged_edges[obj.get("id")] = obj
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "nodes.jsonl").write_text(
        "".join(json.dumps(n, ensure_ascii=False, sort_keys=True) + "\n" for n in merged_nodes.values()), encoding="utf-8")
    (out_dir / "edges.jsonl").write_text(
        "".join(json.dumps(e, ensure_ascii=False, sort_keys=True) + "\n" for e in merged_edges.values()), encoding="utf-8")
    return 0, {"action": "kg_merge", "projects_found": len(project_dirs), "nodes_written": len(merged_nodes),
               "edges_written": len(merged_edges), "duplicate_node_ids_last_write_wins": dup_nodes,
               "duplicate_edge_ids_last_write_wins": dup_edges, "out_dir": str(out_dir)}


def cmd_advise(args):
    err = _need_kernel()
    if err:
        return 1, {"action": "advise", "result": err}
    manifest = load_instance(args.manifest)
    manifest_res = k.validate_release_manifest(manifest)
    if not manifest_res["ok"]:
        return 1, {"action": "advise", "verdict": "BLOCKED",
                    "reasons": [f"release_manifest failed its own schema/kernel check: {e}" for e in manifest_res["errors"]]}

    gate_verdict = manifest.get("gate_verdict")
    if gate_verdict not in ("PASS", "PASS_WITH_LIMITS"):
        return 1, {"action": "advise", "verdict": "BLOCKED",
                    "reasons": [f"release_manifest.gate_verdict is {gate_verdict!r} -- advise() requires "
                                "PASS or PASS_WITH_LIMITS before a conversion_plan may exist (conversion_plan "
                                "template's own precondition, S12 §7). No file written."]}

    scram_reasons = []
    if args.identity and args.identity == manifest.get("human_owner"):
        scram_reasons.append("ADVISOR_IDENTITY_CONFLICT")
    if args.cards:
        cards = [load_instance(p) for p in args.cards]
        declared = manifest.get("k_state_declared")
        for c in cards:
            if declared is not None and c.get("k_state") not in (None, declared):
                scram_reasons.append("K_STATE_MISREPRESENTED")
                break
    if args.citation_cards:
        for p in args.citation_cards:
            cc = load_instance(p)
            if cc.get("status") != "VERIFIED":
                scram_reasons.append("UNVERIFIED_CITATION_IN_SCOPE")
                break
    scram_reasons = sorted(set(scram_reasons))
    if scram_reasons:
        return 1, {"action": "advise", "verdict": "BLOCKED", "scram_reasons": scram_reasons,
                    "note": "checked: ADVISOR_IDENTITY_CONFLICT (vs human_owner), K_STATE_MISREPRESENTED "
                            "(if --cards given), UNVERIFIED_CITATION_IN_SCOPE (if --citation-cards given). "
                            "VENUE_DISCLOSURE_GAP and XENON_THRESHOLD are NOT implemented in this CLI "
                            "(no venue data / no Xenon ledger reader yet) -- always reported CLEAR, never "
                            "silently upgraded to a false pass; a human must check those two by hand."}

    out_dir = Path(args.out_dir) if args.out_dir else REPO_ROOT / "records" / "advisory"
    slug = _slugify(manifest.get("manifest_id") or "plan")
    plan_id = _next_numbered_id(out_dir, lambda n: f"cp-{slug}-{n:04d}")
    expires_at = args.expires_at or _today()
    data = scaffold_conversion_plan(plan_id, manifest.get("manifest_id"), args.identity or "cli:glosa-advise", expires_at)
    res = generic_schema_check(data, "conversion_plan.schema.json")
    written = write_new(out_dir, plan_id, data)
    return (0 if res["ok"] else 1), {"action": "advise", "verdict": "READY_TO_DRAFT" if res["ok"] else "SCHEMA_ERROR",
                                      "plan_id": plan_id, "written": written, "self_check": res,
                                      "note": "VENUE_DISCLOSURE_GAP / XENON_THRESHOLD SCRAM conditions not implemented -- check by hand."}


def cmd_schema_summary(args):
    rows = []
    for fname in _schema_filenames():
        rows.append({
            "file": fname,
            "title": _schema_title(fname),
            "required": sorted(_schema_required(fname)),
        })
    counts = {}
    for name, key in (("disclaimer_catalogue", "disclaimers"), ("genre_router_table", None),
                       ("contaminated_concept_table", None), ("independence_ladder", None),
                       ("non_collapse_table", None)):
        p = REPO_ROOT / "methodology" / "data" / f"{name}.json"
        if p.is_file():
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                if key and isinstance(data, dict) and key in data:
                    counts[name] = len(data[key])
                elif isinstance(data, list):
                    counts[name] = len(data)
                elif isinstance(data, dict):
                    counts[name] = len(data)
            except (OSError, ValueError):
                pass
    return 0, {"action": "schema_summary", "schema_count": len(rows), "schemas": rows,
               "methodology_data_row_counts": counts, "pyyaml_available": HAVE_YAML,
               "jsonschema_available": bool(k and k._HAVE_JSONSCHEMA)}


