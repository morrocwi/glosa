    rows_dir = out_dir / "rows"
    valid_rows, invalid_rows = [], []
    if rows_dir.is_dir():
        for p in sorted(rows_dir.glob("*")):
            if p.suffix not in (".yaml", ".yml", ".json"):
                continue
            try:
                row = load_instance(p)
            except Exception as exc:
                invalid_rows.append({"path": str(p), "error": f"could not parse: {exc}"})
                continue
            res = generic_schema_check(row, "dialogue_table_row.schema.json")
            if res["ok"]:
                valid_rows.append(row)
            else:
                invalid_rows.append({"path": str(p), "errors": res["errors"]})
    table_path = out_dir / "dialogue_table.md"
    if not table_path.is_file():
        return 1, {"action": "lit_table", "error": f"no dialogue_table.md under {out_dir} -- run `glosa lit new` first."}
    text = table_path.read_text(encoding="utf-8")
    header_part, _, _ = text.partition("## Table\n")
    new_text = header_part + "## Table\n\n" + _render_dialogue_table_rows(valid_rows)
    forbidden_marker = "## Forbidden in this table"
    template_text = (TEMPLATES_DIR / "dialogue_table.md").read_text(encoding="utf-8") if (TEMPLATES_DIR / "dialogue_table.md").is_file() else ""
    if forbidden_marker in template_text:
        new_text += "\n" + template_text[template_text.index(forbidden_marker):]
    table_path.write_text(new_text, encoding="utf-8")
    incomplete = [row.get("source_label", "") for row in valid_rows if _dialogue_row_incomplete(row)]
    return 0, {
        "action": "lit_table", "path": str(table_path), "rows_rendered": len(valid_rows), "rows_invalid": invalid_rows,
        "rows_incomplete_defeater": incomplete,  # lrs.dialogue-table-claim-type-column lint (not a hard error) --
