ZENODO_SANDBOX_TOKEN=    # https://sandbox.zenodo.org  (test uploads first)
FORGEJO_TOKEN=           # http://<lan-host>/user/settings/applications  (org anse)
# GitHub: not stored here — `gh auth login` already provides the credential helper (check: gh auth status)
