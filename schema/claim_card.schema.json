{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glosa.example/schema/claim_card.schema.json",
  "title": "glosa claim card",
  "description": "tier: Dr (specified; independently unreviewed). Implements FOUNDATION_v0.5.md §3 (the claim card, final field list), §3.1 (five-questions crosswalk), §3.2a (two legal shapes stub|full, chair ruling B2), §3.2b (formal_applicability plain-language enum), and a schema-expressible SUBSET of §3.3's 11 kernel gate rules (see schema/README.md for the exact schema-enforced vs kernel-enforced split — rules 5, 6, 8 and the full bounded-I2+I4-exception arithmetic of rules 4/9 are NOT expressible in JSON Schema draft-07 and remain kernel-only). Namespace https://glosa.example/ is a placeholder (no public domain yet).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "claim_id",
    "shape",
    "statement",
    "standpoint",
    "claim_type",
    "tier",
    "produced_by",
    "responsible",
    "origin_blackbox_ref",
    "five_questions",
    "non_claims",
    "human_owner",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "0.8.0",
      "description": "0.8.0 (this pass, design/SESSION_ARCH_v0.4_SPEC.md §10.1/§10.2/§10.3/§10.4): five_questions.tested.defeater_class (additive optional, sibling of claim_type -- see rule30), provenance_dag.defeater_log[].{node,date,outcome} now required with an outcome enum (rule: lrs.defeater-defeated-status-field), kernel rule29 (strength-of-claim is not a defeater) and rule30 (defeater_class-appropriate falsifier phrasing) -- both additive/optional, backward-compatible. Lands after 0.7.0 (this pass, design/FOUNDATION_v0.6_PATCH.md): comparison, evidence_strength, verdict_class, gate_fail_taxonomy, gate_construction_status, five_questions.seen.ai_assisted_fields (all additive/optional). Lands after the separately-queued, not-yet-applied 0.6.0 bump (tested.evidence_relations[].channel + rules 13/14, FOUNDATION_v0.5.md §3.2:467) so the change sets do not collide on one version number."
    },
    "claim_id": {
      "type": "string",
      "pattern": "^GLOSA-CC-[0-9]{8}-[0-9]{4}$"
    },
    "shape": {
      "enum": [
        "stub",
        "full"
      ]
    },
    "statement": {
      "type": "object",
      "required": [
        "language",
        "text",
        "is_verbatim_quote"
      ],
      "properties": {
        "language": {
          "$ref": "common.defs.json#/definitions/lang"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "is_verbatim_quote": {
          "type": "boolean"
        },
        "translation": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "language": {
              "$ref": "common.defs.json#/definitions/lang"
            },
            "translation_status": {
              "$ref": "common.defs.json#/definitions/translation_status"
            }
          }
        }
      }
    },
    "standpoint": {
      "type": "object",
      "required": [
        "declared_basis"
      ],
      "properties": {
        "declared_basis": {
          "type": "string",
          "minLength": 1
        },
        "disciplines_not_claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_basis": {
          "type": "string"
        }
      }
    },
    "claim_type": {
      "$ref": "common.defs.json#/definitions/claim_type"
    },
    "genre": {
      "anyOf": [
        {
          "$ref": "common.defs.json#/definitions/genre"
        },
        {
          "type": "null"
        }
      ]
    },
    "venue_track": {
      "anyOf": [
        {
          "$ref": "common.defs.json#/definitions/venue_track"
        },
        {
          "type": "null"
        }
      ]
    },
    "companion_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "produced_by": {
      "$ref": "common.defs.json#/definitions/produced_by"
    },
    "responsible": {
      "const": "human"
    },
    "origin_blackbox_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "lens_translation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "question_human": {
          "type": "object",
          "required": [
            "text_verbatim",
            "language",
            "blackbox_line_ref"
          ],
          "properties": {
            "text_verbatim": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "$ref": "common.defs.json#/definitions/lang"
            },
            "blackbox_line_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "question_readout": {
          "type": "string"
        },
        "local_contrast_space_X": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "restriction_provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_relation_R": {},
        "claim_function_Phi_z0": {},
        "formal_applicability": {
          "$ref": "common.defs.json#/definitions/formal_applicability"
        }
      }
    },
    "hypothesis_world": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "language": {
          "$ref": "common.defs.json#/definitions/lang"
        },
        "falsifier_ref": {
          "type": "string"
        }
      }
    },
    "five_questions": {
      "type": "object",
      "required": [
        "ai_filled",
        "tested"
      ],
      "properties": {
        "seen": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "record_ref": {
              "type": "string"
            },
            "as_of": {
              "type": "string"
            },
            "retrievable_original": {
              "type": "boolean"
            },
            "access_model": {
              "type": "string"
            },
            "citation_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ai_assisted_fields": {
              "description": "NEW this pass (design/FOUNDATION_v0.6_PATCH.md K-C2, rule27 HIDDEN-AI-FILL). Names which of the card's own fields had AI involvement in drafting their seen-recorded content -- a structural marker, not a prose scan. Default [].",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        },
        "separates": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "value_z0": {},
            "licensing_test": {
              "type": "object",
              "properties": {
                "regime": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "zero_vs_bottom": {
              "enum": [
                "0_checked_no_difference",
                "distinct_difference_found",
                "unresolved_bottom"
              ]
            }
          }
        },
        "ai_filled": {
          "type": "object",
          "description": "Two legal shapes exist for this field (chair ruling B2, §3.2a): stub -> {used, note}; full -> the six-key shape below. Which one is legal is enforced by the top-level shape:stub|full if/then in allOf."
        },
        "assumed": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "description",
              "identification_level"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^A[0-9]+$"
              },
              "type": {
                "enum": [
                  "access_augmentation",
                  "contrast_relevance_operation",
                  "inferential_commitment",
                  "decision_policy_augmentation"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "identification_level": {
                "type": "string"
              },
              "contaminated_concept_hit": {}
            }
          }
        },
        "tested": {
          "type": "object",
          "required": [
            "falsifier",
            "evidence_relations"
          ],
          "properties": {
            "evidence_relations": {
              "type": "array",
              "items": {
                "$ref": "evidence_relation.schema.json"
              }
            },
            "falsifier": {
              "type": "string",
              "minLength": 1
            },
            "defeater_class": {
              "description": "SESSION_ARCH_v0.4_SPEC.md §10.4 (lrs.claim-type-defeater-enum), additive/optional. Deliberately a SIBLING of the top-level `claim_type` enum (common.defs.json#/definitions -- EMPIRICAL/FORMAL/INTERPRETIVE/NORMATIVE/CONVENTIONAL_LEGAL/DECISION/SOCIAL/HUMAN_PARTICIPANT), NOT an extension of it -- reusing that enum here would collide on the bare string 'EMPIRICAL'. This is the same five-way EPISTEMIC_FUSION_v8.1.txt §1 taxonomy as the dialogue_table `defeater_class` column (design/S14_literature-review-system.md §3.4, templates/knowledge/dialogue_table.md), inlined here rather than $ref'd to avoid a second enum owner. Paired with `falsifier` by kernel rule30 -- see kernel/glosa_kernel.py `_rule30_defeater_class_error`.",
              "enum": [
                "PHENOMENOLOGICAL",
                "CONSTITUTIVE",
                "STRUCTURAL_FORMAL",
                "DIAGNOSTIC",
                "EMPIRICAL"
              ]
            },
            "dissent_records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "by",
                  "date",
                  "content",
                  "resolved"
                ],
                "properties": {
                  "by": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "resolved": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "identification_ladder": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "adds": {
                "type": "string"
              }
            }
          }
        },
        "per_rival": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rival": {
                "type": "string"
              },
              "first_identification_level": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenance_dag": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "essential_dependency_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defeater_log": {
          "description": "SESSION_ARCH_v0.4_SPEC.md §10.2 (lrs.defeater-defeated-status-field): [{node, date, outcome}], per design/FOUNDATION_v0.6.md:775. Distinguishes 'defeater attempted and survived' (outcome: claim_survived, entry present) from 'never tested' (defeater_log: []).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "date", "outcome"],
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "minLength": 1 },
              "outcome": {
                "enum": ["claim_survived", "claim_revised", "claim_withdrawn"]
              }
            }
          }
        },
        "status": {
          "enum": [
            "not_run",
            "run"
          ],
          "default": "not_run"
        }
      }
    },
    "silent_lift_check": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "represented_dependency_set": {
          "type": "array"
        },
        "actual_dependency_set": {
          "type": "array"
        },
        "flags": {
          "type": "array"
        },
        "status": {
          "enum": [
            "not_run",
            "run"
          ],
          "default": "not_run"
        }
      }
    },
    "scope": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "generalization_claimed": {
          "enum": [
            "none",
            "pattern_candidate",
            "population_claim"
          ]
        },
        "evidence_scope": {
          "type": "string"
        },
        "claim_scope": {
          "type": "string"
        }
      }
    },
    "tier": {
      "$ref": "common.defs.json#/definitions/tier"
    },
    "k_state": {
      "anyOf": [
        {
          "$ref": "common.defs.json#/definitions/k_state"
        },
        {
          "type": "null"
        }
      ]
    },
    "ledger": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "forced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "borrowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "legal_epistemic_separation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
