          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "disclaimers_emitted": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/definitions/disclaimer_ref"
      }
    },
    "status": {
      "$ref": "common.defs.json#/definitions/release_status"
    },
    "lineage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "derives_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
