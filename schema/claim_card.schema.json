      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_citation_cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibility": {
      "description": "OPTIONAL. FOUNDATION_v0.5.md §2.1b, founder instruction 2026-09-04 (BBL-2026-09-04-083/084) -- responsibility per Data->Inference->Claim arrow. Absence emits kernel rule13w (warning), never a hard fail (K0-stub authoring-cost floor, §3.2a). §2.1c: optional ownership {problem, question, hypothesis} — each const human.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "data_to_inference",
        "inference_to_claim"
      ],
      "properties": {
        "data_to_inference": {
          "$ref": "common.defs.json#/definitions/produced_by"
        },
        "inference_to_claim": {
          "const": "human"
        },
        "notes": {
          "type": "string"
        },
        "ownership": {
          "description": "OPTIONAL. FOUNDATION_v0.5.md §2.1c (BBL-2026-09-04-086/087/088): problem, question and the selection of the hypothesis stay human; any other value fails kernel rule 15.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "problem",
            "question",
            "hypothesis_selection"
          ],
          "properties": {
            "problem": {
              "const": "human"
            },
            "question": {
              "const": "human"
            },
            "notes": {
              "type": "string"
            },
            "hypothesis_selection": {
              "const": "human",
              "description": "AI may propose candidate hypotheses; the human selects (BBL-2026-09-04-088)."
            }
          }
        }
      }
    },
    "empirical_extension": {
      "description": "OPTIONAL. FOUNDATION_v0.5.md §2, founder instruction 2026-09-04 (BBL-2026-09-04-083/084) -- operationalization, study design, bias register, robustness. Absence on an EMPIRICAL claim_type emits kernel rule14w (warning), never a hard fail.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "operationalization": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "abstract_term": {
                "type": "string"
              },
              "measured_as": {
                "type": "string"
              },
              "instrument_or_record": {
                "type": "string"
              },
              "unit_or_scale": {
                "type": "string"
              }
            }
          }
        },
        "study_design": {
          "$ref": "common.defs.json#/definitions/study_design"
        },
        "bias_register": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "$ref": "common.defs.json#/definitions/bias_type"
              },
              "description": {
                "type": "string"
              },
              "mitigation": {
                "type": "string"
              },
              "residual": {
                "$ref": "common.defs.json#/definitions/bias_residual"
              }
            }
          }
        },
        "robustness": {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "what_varied": {
                    "$ref": "common.defs.json#/definitions/robustness_what_varied"
                  },
                  "result": {
                    "$ref": "common.defs.json#/definitions/robustness_result"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            },
            "status": {
              "enum": [
                "not_run",
                "partial",
                "run"
              ]
            }
          }
        }
      }
    },
    "comparison": {
      "description": "NEW this pass (design/FOUNDATION_v0.6_PATCH.md §2, schema.claim-card-comparison-evidence-field). `relation` is a closed enum; the forbidden-word-list terms (see scripts/check_forbidden_words.sh; English + Thai, gate rule 6 -- CLAUDE.md/AGENTS.md's governance-file ban on those terms, disambiguated from FOUNDATION §3.3's own numbered kernel rule 6 scope.claim_scope<=scope.evidence_scope) are schema-rejected as `relation`/`basis` values, enforced by rule20. `not_compared` is legal and is the correct default when no comparison was attempted -- once `comparison` is present at all, an empty `basis` is itself a validation error (no silent 'not compared' via omission).",
      "type": ["object", "null"],
      "properties": {
        "target": {
          "type": ["string", "null"]
        },
        "relation": {
          "enum": ["same", "different", "cited", "not_compared"]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(?i)\\b(novel|first|best|outperform)\\w*\\b|(ใหม่|ครั้งแรก|ดีที่สุด|เหนือกว่า)", "$comment": "this is the forbidden-word-list regex itself (scripts/check_forbidden_words.sh), not a claim -- never remove the literal terms here, they are what rule20 rejects" }
        }
      },
      "required": ["relation", "basis"]
    },
    "evidence_strength": {
      "description": "NEW this pass (design/FOUNDATION_v0.6_PATCH.md §2). `direct_validation` = the evidence bears on the intervention/claim itself; `adjacent_precedent` = the evidence bears on a related but distinct prior case, read across by analogy -- this class may never be silently promoted to `direct_validation` in prose that cites it (NC-72 Constraint!=evidence-for-us).",
      "type": ["object", "null"],
      "properties": {
        "class": {
          "enum": ["direct_validation", "adjacent_precedent"]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["class"]
    },
    "verdict_class": {
      "description": "NEW this pass (design/FOUNDATION_v0.6_PATCH.md §5, schema.verdict-class-vocabulary). A different axis from `base_relation`: `base_relation` states how a claim relates to a base text; `verdict_class` states what KIND of derivation the claim itself is, independent of any base-text relation. Rule23 (VERDICT-CLASS-UNLISTED): an unlisted seventh value is a hard schema-validation error -- fully schema-enforced, no kernel code needed (parallels rule 1/2/10/11's schema-only enforcement).",
      "anyOf": [
        {
          "enum": ["DERIVED", "FORCED", "DEFINITIONAL-RELABEL", "POSITED", "BORROWED-SCALE", "OPEN"]
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_fail_taxonomy": {
      "description": "NEW this pass (design/FOUNDATION_v0.6_PATCH.md §1, rule18 TAXONOMY-UNTYPED, kc-base-016 verbatim). Names the specific injected-infinity/zero type when a hard-fail is raised on this card -- never a generic, untyped rejection.",
      "type": ["object", "null"],
      "properties": {
        "injected_infinity_type": {
          "enum": ["I1", "I2", "I3", "I4", null]
        },
        "injected_zero_type": {
          "enum": ["Z1", "Z2", "Z3", "Z4", null]
        }
      }
    },
