          "enum": [
            "NONE",
            "PENDING",
            "PASSED",
            "FAILED"
          ]
        },
        "maker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "checker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approver_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "independence_class": {
          "$ref": "common.defs.json#/definitions/independence_class"
        },
        "mc_level": {
